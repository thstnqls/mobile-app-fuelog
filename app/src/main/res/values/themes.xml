<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Mobileappfuelog" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/fuelog_primary</item>
        <item name="colorPrimaryVariant">@color/fuelog_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/fuelog_primary</item>
        <item name="colorSecondaryVariant">@color/fuelog_primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Mobileappfuelog.NoActionBar" parent="Theme.Mobileappfuelog">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
