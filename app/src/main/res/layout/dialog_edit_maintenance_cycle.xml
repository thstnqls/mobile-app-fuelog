<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialog_edit_cycle_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="소모품 교체 주기 설정"
        android:textColor="@color/fuelog_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="주기를 변경하면 최근 정비 기록을 기준으로 다음 예정일과 예정 누적거리가 자동으로 재계산됩니다."
        android:textColor="@color/fuelog_text_secondary"
        android:textSize="12sp" />

    <!-- 소모품 항목명 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_cycle_item_name"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="소모품 항목명">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_cycle_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:text="엔진오일" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 주행거리 주기 (km) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_cycle_interval_km"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="주행거리 주기"
        app:suffixText="km">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_cycle_interval_km"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="10000" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 기간 주기 (개월) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_cycle_interval_months"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="기간 주기"
        app:suffixText="개월">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_cycle_interval_months"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="12" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
