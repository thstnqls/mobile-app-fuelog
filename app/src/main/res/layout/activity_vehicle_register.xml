<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fuelog_surface"
    android:orientation="vertical">

    <!-- 상단 툴바 (뒤로가기 + 타이틀) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_vehicle_register"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:elevation="1dp"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/fuelog_text_primary"
        app:title="차량 등록"
        app:titleTextColor="@color/fuelog_text_primary"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 1. 안내 카드 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="차량 디스플레이의 QR 코드를\n스캔해 차량을 연동하세요"
                android:textColor="@color/fuelog_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="차량 화면(C01)의 QR 코드를 아래 카메라에 비추면 6자리 비교 확인 코드가 발급됩니다."
                android:textColor="@color/fuelog_text_secondary"
                android:textSize="13sp" />

            <!-- 2. 인라인 카메라 뷰파인더 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_register_inline_camera"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#000000"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/fuelog_primary"
                app:strokeWidth="1.5dp">

                <com.journeyapps.barcodescanner.DecoratedBarcodeView
                    android:id="@+id/barcode_scanner_register"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. QR 스캔 후 차량 디스플레이(C01)의 6자리 승인 코드 직접 입력 영역 -->
            <LinearLayout
                android:id="@+id/layout_register_confirmation_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#1D2B3A"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="차량 디스플레이(C01) 승인 코드 입력"
                    android:textColor="#5CE1A6"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_register_confirmation_code_guide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="차량 디스플레이(C01) 화면에 표시된 6자리 승인 코드를 입력해 주세요."
                    android:textColor="#D0D7DE"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tv_register_code_timer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="남은 입력 시간: 02:00"
                    android:textColor="#5CE1A6"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_register_confirmation_code"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="#0D1824"
                    android:gravity="center"
                    android:hint="6자리 승인 코드 입력"
                    android:inputType="number"
                    android:letterSpacing="0.2"
                    android:maxLength="6"
                    android:textColor="@color/white"
                    android:textColorHint="#6C7A89"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_register_code_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="승인 코드가 일치하지 않습니다. 다시 확인해 주세요."
                    android:textColor="#FF6B6B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layout_register_code_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/pb_register_code_checking"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:indeterminateTint="#5CE1A6" />

                    <TextView
                        android:id="@+id/tv_register_code_loading_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="코드 검사 중..."
                        android:textColor="#5CE1A6"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. 카메라 스캔 재시작 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_register_scan_qr_camera"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="카메라 스캔 재시작 / 권한 허용"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/fuelog_primary"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>